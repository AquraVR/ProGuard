
{
  "name": "proguard",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1558816067948642455",
    "DISCORD_REDIRECT_URI": "https://proguard.guardianpro.workers.dev/auth/discord/callback",
    "OWNER_DISCORD_ID": "1406333881023594576",
    "FIREBASE_PROJECT_ID": "proguarddb"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
